{
  "manifest_version": 3,
  "name": "RaptorQR",
  "version": "0.1.0",
  "description": "Offline QR data transfer.",
  "action": {
    "default_title": "Open RaptorQR"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}